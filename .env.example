# ========================================================
# Komiya WhatsApp AI - Production Environment Variables
# ========================================================

# Public Application URL (ex: https://mon-domaine.com)
APP_URL=https://mon-domaine.com
PORT=3000

# Supabase Production Database (Keep Service Role Key on server only!)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# WASenderAPI Credentials
WASENDER_API_URL=https://wasenderapi.com/api
WASENDER_API_KEY=your_wasender_personal_access_token
WASENDER_WEBHOOK_SECRET=your_wasender_webhook_secret
WASENDER_SESSION_ID=your_session_id

# Gemini AI LLM API Key (Server-side only)
GEMINI_API_KEY=your_gemini_api_key
